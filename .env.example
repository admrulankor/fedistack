# ==============================================================================
# Fedistack Environment Configuration
# Copy this file to `.env` for local development. Never commit real secrets.
# ==============================================================================

# Runtime Environment (managed automatically by Next.js / Bun; defaults to "development")
# NODE_ENV=development

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=fedistack
POSTGRES_PASSWORD=fedistack_dev_password
POSTGRES_DB=fedistack
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fedistack:fedistack_dev_password@localhost:5433/fedistack

# Backend API Server Configuration
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Web Frontend Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Session Security
# Optional: Bootstrap email address granted `instance_admin` role upon first verified magic-link sign-in
INITIAL_ADMIN_EMAIL=admin@example.com
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=fedistack_session
AUTH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Outbound Email / SMTP Configuration (Mailpit default for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fedistack.local
SMTP_FROM_NAME=Fedistack
